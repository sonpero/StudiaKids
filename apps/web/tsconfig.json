{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@studiakids/mascot": ["../../packages/core/src/mascot/index.ts"]
    }
  },
  // mascot/ is imported straight into the browser bundle
  // (docs/modules/mascot.md); dependency-cruiser keeps it self-contained.
  "include": ["src", "../../packages/core/src/mascot"]
}
