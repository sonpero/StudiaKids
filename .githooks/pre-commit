#!/bin/sh
# Enable once per clone: git config core.hooksPath .githooks
# A commit with a red check is refused (decided after M5: one got through
# with a failing typecheck). Stops at the first failure.
set -e

echo "pre-commit: typecheck"
pnpm typecheck >/dev/null 2>&1 || { echo "pre-commit: typecheck failed — commit refused (run pnpm typecheck)"; exit 1; }

echo "pre-commit: lint"
pnpm lint >/dev/null 2>&1 || { echo "pre-commit: lint failed — commit refused (run pnpm lint)"; exit 1; }

# Refuses a commit that would carry an image with metadata (EXIF, GPS...)
# under tests/fixtures: the repository is public (docs/modules/ingestion.md).
echo "pre-commit: fixtures hygiene"
pnpm exec vitest run --project int apps/api/src/cli/fixtures-record/fixtures-hygiene.int.test.ts >/dev/null 2>&1 || { echo "pre-commit: an image under tests/fixtures carries metadata — commit refused"; exit 1; }
